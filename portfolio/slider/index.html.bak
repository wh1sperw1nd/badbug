<script type="text/javascript">
    //    checkBrowser(0);
    function checkBrowser(videoUrl)
    {
        if ($.browser.mozilla || $.browser.webkit) {
           
                videoUrl = videoUrl.substr(0,videoUrl.length-3);
                videoUrl += "ogv";
                var result = [];
                result['url'] = videoUrl;
                result['type'] = 'video/ogg; codecs="theora, vorbis"';
                return result;
                //$("#video_source").attr("src",videoUrl);
                //$("#video_source").attr("type",'video/ogg; codecs="theora, vorbis"');
            
          }
         else if($.browser.safari)
         {
             if(videoUrl == 0){
                $("#video_source").attr("src","http://testsrm.tra.cx/media/jplayer/hulk.m4v");
                $("#video_source").attr("type",'video/mp4; codecs="avc1.42E01E, mp4a.40.2"');
            }
             else
                 {
                     videoUrl = videoUrl.substr(0,videoUrl.length-3);
                videoUrl += "m4v";
                var result = [];
                result['url'] = videoUrl;
                result['type'] = 'video/ogg; codecs="theora, vorbis"';
                return result;
                //$("#video_source").attr("src",videoUrl);
                //$("#video_source").attr("type",'video/mp4; codecs="avc1.42E01E, mp4a.40.2"');
		
                 }
         }
         else if($.browser.msie)
         {

             if(videoUrl == 0){
                $("#video_source").attr("src","http://testsrm.tra.cx/media/jplayer/hulk.m4v");
                $("#video_source").attr("type",'video/mp4; codecs="avc1.42E01E, mp4a.40.2"');
            }
             else
                 {
                     videoUrl = videoUrl.substr(0,videoUrl.length-3);
                videoUrl += "m4v";
                //$("#video_source").attr("src",videoUrl);
                //$("#video_source").attr("type",'video/mp4; codecs="avc1.42E01E, mp4a.40.2"');
                
                var result = [];
                result['url'] = videoUrl;
                result['type'] = 'video/ogg; codecs="theora, vorbis"';
                return result;

                 }
         }
         else 
         {
             if(videoUrl == 0)
                $("#video_source").attr("src","http://testsrm.tra.cx/media/jplayer/hulk.ogv");
            else
                {
                    videoUrl = videoUrl.substr(0,videoUrl.length-3);
                    videoUrl += "ogv";
                    $("#video_source").attr("src",videoUrl);
			$("#video_source").attr("type",'video/ogg; codecs="theora, vorbis"');
			
                }
         }
    }
    
    
     
 var fullscreen = 0;
	var video = ({
		setVideo: function(videoUrl, poster){
              //  if(document.getElementById("videojs").player.html5Supported()){
                  var picture = 0;
                  var type;
                  var format = videoUrl.match(/\.([^\.]+)$/);
                  var source;
                  if(format[1] == "ogv")
                      type = 'video/ogg; codecs="theora, vorbis"';
                  else if(format[1] == "mp4")
                      type = 'video/mp4; codecs="avc1.42E01E, mp4a.40.2"';
                  else if(format[1] == "webm")
                      type = 'video/webm; codecs="vp8, vorbis"';
                  else if(format[1] == "jpeg" || format[1] == "jpg" || format[1] == "png" || format[1] == "gif"){
                      type = 'video/webm; codecs="vp8, vorbis"';
                      picture = 1;
                  }
                  
                  var chBrow = checkBrowser(videoUrl);
                  //source = "<source id='video_source' src='"+chBrow['url']+"' type='"+chBrow['type']+"' />";
                  //http://testsrm.tra.cx/media/jplayer/hulk.ogv
                  
                  source = "<source id='video_source' src='"+chBrow['url']+"' type='"+chBrow['type']+"' />";
			console.info(1);
                        
                        
                   var video = '<video id="videojs" class="video-js" width="481px" height="320px" controls="controls" preload="auto" poster="'+poster+'">'+source+'</video>';
                   var resize ='<div id="resize" class="resize" onmousedown="resize();"></div>';
                   var html = video;
                   
                   jQuery("#playerContainer").show();
                   //jQuery("#videoBlock").show();
                   $("#videoBlock").empty().append(html);
                   
		$("#videojs").attr("poster",poster);
                
                
                   //$("#videoBlock").empty().append(html);
                   //checkBrowser(videoUrl);
                   //VideoJS.setup("videojs"); 
                   VideoJS.setupAllWhenReady();
                
                
                

//			document.getElementById("videojs").player.forceTheSource();
//                       document.getElementById("videojs").player.playerOnVideoEnded();
//                       document.getElementById("videojs").player.showBigPlayButtons();
//document.getElementById("videojs").player.playerOnVideoPause();
			//$(".vjs-play-control").removeClass("vjs-playing");
			//$(".vjs-play-control").addClass("vjs-paused");
//			$("#videojs").removeClass("vjs-playing");
			//$("#videojs").addClass("vjs-paused");
//$("#videoBlock").removeClass("vjs-playing");
			//$("#videoBlock").addClass("vjs-paused");


                   //VideoJS.setup("videojs"); 
                   if(picture == 1)
                   {
                        $(".vjs-big-play-button").remove();
                         $(".vjs-spinner").remove();
                         $(".vjs-controls").remove();
                         //document.getElementById("videojs").player.play();
                   }
                        fullscreen = 0;
                        $(".vjs-fullscreen-control").click(function(){
                            if(fullscreen == 0){
                                $("#videoBlock").css("width","");
                                $("#videoBlock").css("height","");
                                fullscreen = 1;
                            }
                            else
                            {
                                fullscreen = 0;
                            }
                        });
                       
                   // }
		}
	});


function resize(){
//videoBlock
    
        $("#videojs").css("height","");
         $("#videojs").css("width","");
                //$("#videojs").css("height","");
            $("body").mousemove(function(e){ 
                    if(e.pageX<=1104 && e.pageY<=495){
                        
                  document.getElementById("videojs").player.width(e.pageX-310);
                  document.getElementById("videojs").player.height(e.pageY-130);
                  }
                 // console.info("x: "+e.pageX+" y: "+e.pageY);
                 // console.info();
            });
   }

jQuery(document).ready(function(){ 
    
     $(".selected").live("click",function(){
         //alert('ok');
         if(jQuery(".selected").attr("video")!==undefined){
         $("#playerContainer").css("display","block");
         //alert($(this).attr("video"));
         video.setVideo($(this).attr("video"),$(this).attr("poster"));
         }
      //    VideoJS.setupAllWhenReady();
     });
    
    //jQuery('#mycarousel').jcarousel();
    //$(".vjs-play-progress").css("display","none");
    $("body").css("height",$(window).height());
    
    
    $('#videoBlock').disableTextSelect();
    
   
   
   $("body").mouseup(function(e){
       
       $("body").unbind("mousemove");

    });
    
    $("body").mouseleave(function(e){
       
       $("body").unbind("mousemove");

    });
    

    $(".vjs-fullscreen-control").click(function(){
        if(fullscreen == 0){
            $("#videoBlock").css("width","");
            $("#videoBlock").css("height","");
        fullscreen = 1;
    }
    else
    {
        fullscreen = 0;
    }
    });
    
    
